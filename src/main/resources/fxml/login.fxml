<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>
    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Prijava u sustav"/>
    <TextField fx:id="usernameField" promptText="Korisničko ime"/>
    <PasswordField fx:id="passwordField" promptText="Lozinka"/>
    <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>
    <Button fx:id="loginButton" defaultButton="true" onAction="#handleLogin" text="Prijava"/>
</VBox>
