<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <TextField fx:id="searchField" promptText="Pretraga po korisničkom imenu ili imenu"/>
            <Button onAction="#handleSearch" text="Pretraži"/>
            <Button fx:id="addButton" onAction="#handleAdd" text="Dodaj"/>
            <Button fx:id="editButton" onAction="#handleEdit" text="Uredi"/>
            <Button fx:id="deleteButton" onAction="#handleDelete" text="Obriši"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tableView">
            <columns>
                <TableColumn fx:id="firstNameColumn" prefWidth="100" text="Ime"/>
                <TableColumn fx:id="lastNameColumn" prefWidth="100" text="Prezime"/>
                <TableColumn fx:id="usernameColumn" prefWidth="100" text="Korisničko ime"/>
                <TableColumn fx:id="emailColumn" prefWidth="150" text="Email"/>
                <TableColumn fx:id="roleColumn" prefWidth="100" text="Rola"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
