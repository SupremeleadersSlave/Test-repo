<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <Button fx:id="refreshButton" onAction="#reload" text="Osvježi"/>
    <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="monthColumn" text="Mjesec" prefWidth="160"/>
            <TableColumn fx:id="reservationsColumn" text="Rezervacija" prefWidth="140"/>
            <TableColumn fx:id="guestsColumn" text="Gostiju" prefWidth="140"/>
        </columns>
    </TableView>
</VBox>
