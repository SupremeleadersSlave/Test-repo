<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <TextField fx:id="searchField" promptText="Pretraga po broju ili vrsti sobe"/>
            <Button onAction="#handleSearch" text="Pretraži"/>
            <Button fx:id="addButton" onAction="#handleAdd" text="Dodaj"/>
            <Button fx:id="editButton" onAction="#handleEdit" text="Uredi"/>
            <Button fx:id="deleteButton" onAction="#handleDelete" text="Obriši"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tableView">
            <columns>
                <TableColumn fx:id="roomNumberColumn" prefWidth="100" text="Broj sobe"/>
                <TableColumn fx:id="typeColumn" prefWidth="100" text="Vrsta"/>
                <TableColumn fx:id="priceColumn" prefWidth="100" text="Cijena/noć"/>
                <TableColumn fx:id="capacityColumn" prefWidth="100" text="Kapacitet"/>
                <TableColumn fx:id="statusColumn" prefWidth="110" text="Status"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
